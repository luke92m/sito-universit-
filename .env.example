# Copia questo file in .env.local e inserisci i valori del progetto Supabase
# (Supabase → Project Settings → API). La chiave anon è pubblica per design: la sicurezza è data dalle policy RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pubblico del sito, usato nei link delle email di conferma (in locale: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
